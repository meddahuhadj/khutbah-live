# --- Copiez ce fichier en .env et renseignez votre clé ---

# Clé API Google Gemini (https://aistudio.google.com/apikey). OBLIGATOIRE pour la traduction.
GEMINI_API_KEY=

# Modèle Gemini utilisé pour la traduction (et la transcription audio de repli).
# gemini-2.5-flash = bon compromis latence / qualité / prix. gemini-2.5-pro = plus fidèle, plus lent.
GEMINI_MODEL=gemini-2.5-flash

# Hôte / port du serveur.
HOST=0.0.0.0
PORT=8000

# URL publique de base (pour les QR codes) si le serveur est derrière un proxy / nom de domaine.
# Ex : https://khutbah.ma-mosquee.org  — laisser vide pour déduire de la requête.
PUBLIC_BASE_URL=

# Langues traduites par défaut même sans auditeur (préchauffage / aperçu diffuseur). Vide = aucune.
DEFAULT_TARGET_LANGS=

# Nombre de phrases conservées dans l'historique par session.
MAX_HISTORY=40

# Sécurité : nombre max d'auditeurs par session et taille max d'un chunk audio (octets).
MAX_LISTENERS=1500
MAX_AUDIO_BYTES=2000000

# Mettre à 1 pour autoriser le mode dégradé sans clé Gemini (diffuse l'arabe seul, pas de traduction).
ALLOW_NO_API_KEY=1
