# --- Copiez ce fichier en .env et renseignez au moins un fournisseur ---

# ============================================================================
#  TRADUCTION — chaîne de repli multi-fournisseurs
#  Ordre d'essai (seuls ceux avec une clé sont tentés) ; le 1er qui répond gagne.
# ============================================================================
TRANSLATE_PROVIDERS=gemini,groq,openrouter,azure

# --- Gemini (meilleure fidélité religieuse) — https://aistudio.google.com/apikey
# Astuce anti-quota : plusieurs clés (projets Google Cloud différents), séparées par des virgules.
GEMINI_API_KEY=
# GEMINI_API_KEYS=cle_projet_1,cle_projet_2,cle_projet_3
GEMINI_MODEL=gemini-2.5-flash-lite
# gemini-2.5-flash = un cran au-dessus mais quota gratuit vite atteint ; -pro = plus fidèle, plus lent.

# --- Groq (gratuit, très rapide, bon en arabe) — https://console.groq.com/keys
GROQ_API_KEY=
# Facultatif : liste de modèles essayés dans l'ordre (le 1er dispo est mémorisé).
# Par défaut : openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile, llama-3.1-8b-instant
# (Groq renomme/retire souvent ses modèles et certains passent en payant -> la liste s'auto-adapte.)
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3

# --- OpenRouter (une clé -> plusieurs modèles, dont des ":free") — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Défaut : llama-3.3-70b-instruct:free, qwen-2.5-72b-instruct:free, deepseek-chat:free
# OPENROUTER_MODELS=qwen/qwen-2.5-72b-instruct:free,deepseek/deepseek-chat:free

# --- Azure AI Translator (2 M caractères/mois gratuits ; traduction pure, sans détection Coran)
# Portail Azure -> ressource "Translator" -> Keys and Endpoint
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# ============================================================================
#  TRANSCRIPTION AUDIO (mode « Audio → serveur », repli non-Chrome / iOS)
# ============================================================================
# groq = Whisper large-v3 (gratuit, excellent arabe/darija) ; gemini = repli.
STT_PROVIDERS=groq,gemini

# ============================================================================
#  Serveur
# ============================================================================
HOST=0.0.0.0
PORT=8000

# URL publique (liens / QR) si derrière un proxy / nom de domaine. Vide = déduit de la requête.
# Si l'imam ouvre l'appli sur localhost, le lien/QR est automatiquement réécrit avec l'IP LAN.
PUBLIC_BASE_URL=

# Langues traduites par défaut même sans auditeur (ex: "fr,en,nl"). Vide = aucune.
DEFAULT_TARGET_LANGS=

# Limites
MAX_HISTORY=40
MAX_LISTENERS=1500
MAX_AUDIO_BYTES=2000000
MAX_ROOMS=300
IDLE_ROOM_TTL=1200
SEG_QUEUE_MAX=24

# 1 = autoriser le démarrage sans aucun fournisseur (mode dégradé : arabe seul).
ALLOW_NO_API_KEY=1
